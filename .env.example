# ================================================================
# ThreatLens AI - Environment Configuration
# ================================================================

# Application
APP_NAME=ThreatLens AI
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Groq API for Multi-Agent LLM Reasoning
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Persistent Memory Integration
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=threatlens-security-memory

# MongoDB Storage Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=threatlens_db
